# ---- 数据库（docker compose up -d 后默认可用，端口 5433 避免与本机 Postgres 冲突）----
DATABASE_URL="postgresql://straystar:straystar@localhost:5433/straystar?schema=public"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="please-generate-with-openssl-rand-base64-32"

# ---- AI Provider ----------------------------------------------------------
# 可选：mock | openai | qwen | glm | deepseek
# mock 无需任何 key，全流程可跑通（物种判定/健康分级/标签抽取/引用问答/向量检索均为确定性规则）
AI_PROVIDER="mock"

# 统一变量（OpenAI 兼容协议，换厂商时只需改这几个）
AI_API_KEY=""
AI_BASE_URL=""                       # 留空则按 AI_PROVIDER 用各自官方地址
AI_MODEL=""                          # 文本 + 视觉共用同一个模型（多模态时最省事，如 glm-4.6v-flash）
AI_CHAT_MODEL=""                     # 单独指定文本模型，留空取 AI_MODEL：gpt-4o-mini / qwen-plus / glm-4.6v-flash / deepseek-chat
AI_VISION_MODEL=""                   # 单独指定视觉模型，留空取 AI_MODEL：gpt-4o / qwen-vl-max-latest / glm-4.6v-flash
AI_EMBED_MODEL=""                    # 留空则用各家默认：text-embedding-3-small / text-embedding-v3 / embedding-3

# 过载降级链（免费档模型高峰期会返回 429 / 1305「访问量过大」）
# 文本按顺序降级；视觉只能降到视觉模型，否则等于让模型闭眼看图
AI_FALLBACK_MODELS=""                # glm 默认：glm-4.5-flash,glm-4.5v
AI_VISION_FALLBACK_MODELS=""         # glm 默认：glm-4.5v,glm-4v-flash

# 思考链（GLM 4.5/4.6 支持）：disabled / enabled / 留空=不传参数
# 开启后每次调用多吐一大段 reasoning_content，实测同一句话 17s vs 1.3s
AI_THINKING=""

# 单个模型单次尝试的超时（毫秒），默认 12000。
# 必须明显小于 AI_TIMEOUT_MS：总预算是整条降级链共用的，主模型"卡住但不断开"时
# 会把它一个人吃光，备选模型一次都轮不到（表现为转满总时长后报"认不出来"）。
AI_ATTEMPT_TIMEOUT_MS=""

# 厂商专用 key（任一有值即可通过 hasKey 检查）
OPENAI_API_KEY=""
QWEN_API_KEY=""
GLM_API_KEY=""
DEEPSEEK_API_KEY=""

# 图片回传：/uploads/xxx.jpg 这类相对路径需要拼成绝对地址供视觉模型访问
AI_PUBLIC_BASE_URL="http://localhost:3000"
# 单次调用超时（毫秒），默认 20000
AI_TIMEOUT_MS="20000"
# Agent 单个工具的执行上限（毫秒），默认 8000。接真模型后工具内部要等一次 AI 调用，建议放宽
AGENT_TOOL_TIMEOUT_MS="8000"

# ---- 存储 ----
UPLOAD_DIR="public/uploads"

# ---- 校园地图中心点（首页星图初始视野 + 建档表单默认落点）----
# **WGS-84**，不是高德/腾讯 POI 直接给的那个数（那些是 GCJ-02，差约 500m；
# 用 src/lib/geo.ts 的 gcj02ToWgs84() 反解后再填）。
# 当前值 = 武汉华夏理工学院光谷校区（POI GCJ-02 30.467068,114.411298 反解）。
# 必须与种子点位同域：种子分布 lat 30.467184–30.471584 / lng 114.402764–114.409064
# db:selftest 有「中心落在点位包围盒内 + 到每个点位 ≤2km」断言，改坏了会直接失败
CAMPUS_CENTER_LAT="30.469384"
CAMPUS_CENTER_LNG="114.405764"
CAMPUS_ZOOM="17"
# 校园围栏半径（米）：建档/观察落点只接受围栏内的坐标
CAMPUS_RADIUS_M="2000"

# ---- 坐标聚合（阶段 2 建骨架，默认关闭）----
# 0 = 不聚合，星图用真实点位；填 50 则把点位吸附到 50m 网格（隐私保守方案）。
# 聚合逻辑只在 src/lib/map/snap.ts，改这里就是全站开关。
MAP_SNAP_GRID_M="0"

# ---- 管理端登录（账号 + 密码）----
# 账号未配置即为 admin；密码优先 ADMIN_PASSWORD，留空回落到 ADMIN_TOKEN（兼容旧配置）。
# 两者都没配 = 门禁关闭（/admin 提示"未启用"）。
# cookie 只存 HMAC(NEXTAUTH_SECRET, 账号\n密码) 摘要，凭据不落库不落 cookie；
# 演示前在 .env 里配一个真实值（示例文件的占位值请勿用于生产）。
ADMIN_ACCOUNT="admin"
ADMIN_PASSWORD=""
ADMIN_TOKEN=""

# ---- 底图瓦片 ----
# 默认接高德路网（免 key、国内直连、带道路与地名），浅色瓦片由 TONE=dark 反色压暗成夜视底。
# 换成别的源时注意两件事：
#   1) CARTO basemaps 现在要 API key，无 key 会返回 200 + 一张「API KEY REQUIRED」水印图，
#      前端收不到 tileerror，降级逻辑不会触发 —— 要么填带 key 的地址，要么别用；
#   2) 国内瓦片是 GCJ-02 坐标，必须 CRS=gcj02 才会把点位纠偏，否则整片星点偏 300–600m。
# 留空（""）= 完全不挂 TileLayer，用内置 CSS 星场（离线演示最稳）。
NEXT_PUBLIC_MAP_TILE_URL="https://webrd0{s}.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}"
# gcj02（高德/腾讯）｜wgs84（OSM/CARTO/自建）。留空则按域名自动判断
NEXT_PUBLIC_MAP_TILE_CRS="gcj02"
# dark（浅色瓦片反色压暗）｜none（原色铺，卫星影像用这个）
NEXT_PUBLIC_MAP_TILE_TONE="dark"
